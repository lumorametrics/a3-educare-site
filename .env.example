VITE_WORDPRESS_API=https://staging.a3educarehub.in/wp-json/wp/v2
# Public origin of this frontend — used for canonical URLs, Open Graph and sitemap.xml.
VITE_SITE_URL=https://www.example.com

# Contact form (Fluent Forms) submissions go to WordPress admin-ajax.php, which sends no CORS
# headers. In development Vite proxies /wp-ajax to it. In production either point this at a
# same-origin proxy path on your host (e.g. /wp-ajax -> https://<wordpress>/wp-admin/admin-ajax.php),
# or leave it unset and allow your frontend origin for admin-ajax in WordPress.
# VITE_WP_AJAX_URL=/wp-ajax
